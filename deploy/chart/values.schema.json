{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fullnameOverride",
    "image",
    "queue",
    "worker",
    "collector",
    "temporal",
    "observability",
    "networkPolicy"
  ],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Never",
            "IfNotPresent",
            "Always"
          ]
        }
      }
    },
    "queue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "persistence",
        "faultAfterTicketOnce"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "storageClass"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "faultAfterTicketOnce": {
          "type": "boolean"
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[^@ ]+@sha256:[a-f0-9]{64}$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "resources",
        "persistence"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[^@ ]+@sha256:[a-f0-9]{64}$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "storageClass"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "prometheusImage",
        "grafanaImage",
        "prometheusResources",
        "grafanaResources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "prometheusImage": {
          "type": "string",
          "pattern": "^[^@ ]+@sha256:[a-f0-9]{64}$"
        },
        "grafanaImage": {
          "type": "string",
          "pattern": "^[^@ ]+@sha256:[a-f0-9]{64}$"
        },
        "prometheusResources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "grafanaResources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
